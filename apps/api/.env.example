# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000

# Public URL users open in the browser (Vite dev server locally, CloudFront URL in AWS).
APP_PUBLIC_URL=http://localhost:5173

# memory = in-process store (no Docker needed, data lost on restart)
# dynamodb = DynamoDB Local (docker compose) or real DynamoDB in AWS
DB_DRIVER=memory
AWS_REGION=ap-southeast-1
USERS_TABLE_NAME=poc-users
# Only for DynamoDB Local. Leave empty in AWS.
DYNAMODB_ENDPOINT=http://localhost:8000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=3600

# Optional Google login. Leave empty to disable.
# Authorized redirect URI in Google Cloud Console: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
