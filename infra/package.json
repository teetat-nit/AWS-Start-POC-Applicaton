{
  "name": "infra",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "infra": "bin/app.ts"
  },
  "scripts": {
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy:dev": "cdk deploy -c env=dev",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.278.0",
    "cdk-nag": "^3.1.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "aws-cdk": "^2.1149.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  }
}
